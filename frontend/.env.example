# Babees Place — Frontend environment variables (example)
# Copy this file to `.env` and fill in real values. NEVER commit the real `.env`.
#
# Exact names required by the app (local, CI, and Vercel — must match):
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_ANON_KEY
#
# Only the Supabase project URL and the PUBLIC anon key belong in the frontend.
# The anon key is safe to ship to the browser; the service-role key must NEVER
# appear here or anywhere in client code.
#
# Vercel: set the same two names under Project Settings → Environment Variables
# (Root Directory = frontend), then Redeploy. Names without the VITE_ prefix are ignored.

# Your Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Your Supabase PUBLIC anon key (JWT with "role":"anon")
VITE_SUPABASE_ANON_KEY=

# Public site origin used for canonical, Open Graph, Twitter, JSON-LD, sitemap, and robots.
# Example: https://babeesplace.vercel.app  (no trailing slash)
# VITE_SITE_URL=https://your-production-domain.com

# ---------------------------------------------------------------------------
# Workstream 6 — Payments (optional)
# ---------------------------------------------------------------------------
# Payment provider switch: mock (default) | daraja
# VITE_PAYMENT_PROVIDER=mock

# Mock auto-success delay in ms (development only)
# VITE_MOCK_MPESA_AUTO_SUCCEED_MS=2500

# LIVE DARAJA — Edge Function base URL (never put secrets in Vite env)
# VITE_MPESA_EDGE_URL=https://<project-ref>.supabase.co/functions/v1/mpesa
#
# OAuth smoke test (server-side only — see supabase/functions/mpesa/README.md):
#   GET/POST {edge}/oauth  → { ok, authenticated, expiresIn }  (access token NOT returned)
#
# Server-side secrets (Edge Function / backend ONLY — not for frontend):
#   Copy: supabase/functions/mpesa/.env.example → supabase/functions/.env
#   Or:   supabase secrets set MPESA_CONSUMER_KEY=... MPESA_CONSUMER_SECRET=...
#   MPESA_CONSUMER_KEY=
#   MPESA_CONSUMER_SECRET=
#   MPESA_ENV=sandbox
# Later for STK Push only (do not invent if portal shows N/A):
#   MPESA_PASSKEY=
#   MPESA_SHORTCODE=
#   MPESA_CALLBACK_URL=

# ---------------------------------------------------------------------------
# Workstream 7 — Notifications (optional)
# ---------------------------------------------------------------------------
# Email provider: mock (default) | resend
# VITE_EMAIL_PROVIDER=mock
# LIVE email Edge Function (secrets server-side only):
# VITE_EMAIL_EDGE_URL=https://<project-ref>.supabase.co/functions/v1/email

# SMS provider: mock (default) | africastalking | twilio
# VITE_SMS_PROVIDER=mock
# VITE_SMS_EDGE_URL=https://<project-ref>.supabase.co/functions/v1/sms

# Push (architecture stub only — not implemented):
# VITE_PUSH_PROVIDER=stub

# ---------------------------------------------------------------------------
# Workstream 9 — Operations (optional)
# ---------------------------------------------------------------------------
# Log level: debug | info | warn | error | silent
# VITE_LOG_LEVEL=info

# Error provider: console (default) | sentry | otel
# VITE_ERROR_PROVIDER=console
# VITE_SENTRY_DSN=  (server/Edge preferred — do not expose secrets)

# Enable service worker registration in production builds
# VITE_ENABLE_SW=false

