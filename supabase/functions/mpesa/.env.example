# Local Edge Function secrets for `supabase functions serve`
# Copy to supabase/functions/.env (gitignored) — NEVER commit real values.
# NEVER put these in frontend/.env or any VITE_* variable.

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Required later for STK Push only (leave blank for OAuth smoke test):
# MPESA_PASSKEY=
# MPESA_SHORTCODE=
# MPESA_CALLBACK_URL=
